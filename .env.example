# ─── Core ───────────────────────────────────────────────
DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms?schema=public"
# Generate with: openssl rand -base64 48   (min 32 chars)
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public base URL (used in email links)
APP_URL="http://localhost:3000"

# ─── Sessions & login security ─────────────────────────
SESSION_IDLE_MINUTES=60          # rolling idle timeout
SESSION_ABSOLUTE_HOURS=12        # hard limit regardless of activity
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
BCRYPT_COST=12

# ─── Email ──────────────────────────────────────────────
# console = print emails to the server log (dev); smtp = send via SMTP (Mailpit in docker-compose)
EMAIL_TRANSPORT="console"
EMAIL_FROM="HR Portal <no-reply@example.com>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ─── Files ──────────────────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=5

# ─── Background jobs ────────────────────────────────────
JOBS_TIMEZONE="Asia/Dubai"

# ─── Optional SSO (providers are enabled only when set) ─
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
