# Local development: the app runs natively (npm run dev) and talks to Postgres + Mailpit started by
# `docker compose up -d`. These defaults match docker-compose.yml, so only AUTH_SECRET needs changing.
# (docker-compose.prod.yml does NOT read this file — it sets its own environment.)

# ─── Core ───────────────────────────────────────────────
# Postgres from docker-compose.yml (user/password/db = hrms)
DATABASE_URL="postgresql://hrms:hrms@localhost:5432/hrms?schema=public"
# Min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public base URL (used in email links)
APP_URL="http://localhost:3000"

# ─── Sessions & login security ─────────────────────────
SESSION_IDLE_MINUTES=60          # rolling idle timeout
SESSION_ABSOLUTE_HOURS=12        # hard limit regardless of activity
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
BCRYPT_COST=12

# ─── Email ──────────────────────────────────────────────
# smtp = send to Mailpit from docker-compose.yml (read them at http://localhost:8025)
# console = print emails to the terminal instead (no Mailpit needed)
EMAIL_TRANSPORT="smtp"
EMAIL_FROM="HR Portal <hr@falcongulf.ae>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# ─── Files ──────────────────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=5

# ─── Background jobs ────────────────────────────────────
JOBS_TIMEZONE="Asia/Dubai"

# ─── Optional SSO (providers are enabled only when set) ─
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
