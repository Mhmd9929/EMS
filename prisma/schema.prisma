// HRMS data model. See docs/ARCHITECTURE.md for conventions:
//  - every business table has companyId
//  - timestamps are UTC (timestamptz); calendar dates use @db.Date
//  - HR records are never hard-deleted

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Company ───────────────────────────────

model Company {
  id                   String   @id @default(cuid())
  name                 String
  legalName            String?
  logoPath             String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  emirate              String?
  country              String   @default("AE")
  phone                String?
  email                String?
  website              String?
  tradeLicenseNumber   String?
  currency             String   @default("AED")
  timezone             String   @default("Asia/Dubai")
  /// ISO weekdays that are working days (1 = Monday … 7 = Sunday)
  workWeek             Int[]    @default([1, 2, 3, 4, 5])
  /// 1 = January
  fiscalYearStartMonth Int      @default(1)
  locale               String   @default("en")
  employeeNumberPrefix  String  @default("EMP-")
  employeeNumberPadding Int     @default(4)
  employeeNumberNextSeq Int     @default(1)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  users          User[]
  roles          Role[]
  departments    Department[]
  positions      Position[]
  locations      Location[]
  employees      Employee[]
  auditLogs      AuditLog[]
  publicHolidays PublicHoliday[]
}

// ─────────────────────────────── Identity & RBAC ───────────────────────────────

model User {
  id                 String    @id @default(cuid())
  companyId          String
  email              String    @unique
  name               String
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  isActive           Boolean   @default(true)
  /// bumped to invalidate every existing session of this user
  sessionVersion     Int       @default(1)
  passwordChangedAt  DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  locale             String?
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  company    Company     @relation(fields: [companyId], references: [id])
  employee   Employee?
  roles      UserRole[]
  authTokens AuthToken[]
  auditLogs  AuditLog[]  @relation("AuditActor")

  @@index([companyId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  /// stable machine key, e.g. SUPER_ADMIN; custom roles get a generated key
  key         String
  name        String
  description String?
  /// system roles cannot be deleted; SUPER_ADMIN permissions are locked
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, key])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  /// SHA-256 of the raw token; the raw token only ever exists in the email link
  tokenHash String        @unique
  expiresAt DateTime      @db.Timestamptz(3)
  usedAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─────────────────────────────── Organisation ───────────────────────────────

model Department {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  code           String
  costCenterCode String?
  description    String?
  parentId       String?
  headId         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  company   Company      @relation(fields: [companyId], references: [id])
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  head      Employee?    @relation("DepartmentHead", fields: [headId], references: [id])
  employees Employee[]   @relation("EmployeeDepartment")

  @@unique([companyId, code])
  @@index([companyId, parentId])
}

model Position {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  code        String
  grade       String?
  level       Int?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, code])
}

model Location {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  address   String?
  city      String?
  emirate   String?
  country   String   @default("AE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id])
  employees      Employee[]
  publicHolidays PublicHoliday[]

  @@unique([companyId, code])
}

// ─────────────────────────────── Employees ───────────────────────────────

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum Gender {
  MALE
  FEMALE
}

model Employee {
  id             String         @id @default(cuid())
  companyId      String
  userId         String?        @unique
  employeeNumber String
  firstName      String
  lastName       String
  preferredName  String?
  workEmail      String
  personalEmail  String?
  phone          String?
  dateOfBirth    DateTime?      @db.Date
  gender         Gender?
  nationality    String?
  maritalStatus  String?
  address        String?
  photoPath      String?

  joinDate        DateTime       @db.Date
  probationEndDate DateTime?     @db.Date
  employmentType  EmploymentType @default(FULL_TIME)
  status          EmployeeStatus @default(ACTIVE)
  departmentId    String?
  positionId      String?
  managerId       String?
  locationId      String?

  // UAE identity documents
  emiratesIdNumber  String?
  emiratesIdExpiry  DateTime? @db.Date
  passportNumber    String?
  passportExpiry    DateTime? @db.Date
  visaNumber        String?
  visaExpiry        DateTime? @db.Date
  labourCardNumber  String?
  labourCardExpiry  DateTime? @db.Date

  // Bank (WPS)
  bankName          String?
  iban              String?
  bankAccountName   String?

  // Termination
  lastWorkingDay    DateTime? @db.Date
  terminationReason String?
  terminationNotes  String?
  terminatedAt      DateTime? @db.Timestamptz(3)
  terminatedById    String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company           Company            @relation(fields: [companyId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  department        Department?        @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  position          Position?          @relation(fields: [positionId], references: [id])
  location          Location?          @relation(fields: [locationId], references: [id])
  manager           Employee?          @relation("ReportingLine", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("ReportingLine")
  headOfDepartments Department[]       @relation("DepartmentHead")
  emergencyContacts EmergencyContact[]

  @@unique([companyId, employeeNumber])
  @@unique([companyId, workEmail])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([companyId, managerId])
  @@index([companyId, lastName, firstName])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String
  name         String
  relationship String
  phone        String
  email        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─────────────────────────────── Calendar ───────────────────────────────

model PublicHoliday {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  date       DateTime @db.Date
  year       Int
  /// null = applies to every location
  locationId String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([companyId, year])
}

// ─────────────────────────────── Audit ───────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  summary     String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, actorUserId])
}
